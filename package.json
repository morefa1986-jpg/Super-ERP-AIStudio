{
  "name": "fathi-aqua-super-erp",
  "private": true,
  "version": "5.2.0",
  "productName": "Fathi Aqua Super ERP",
  "description": "سامانه کاملاً آفلاین مدیریت مزرعه ماهیان خاویاری فتحی",
  "author": "Fathi Aqua",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server.cjs",
    "desktop:start": "npm run build && electron .",
    "desktop:package": "npm run build && electron-forge package",
    "desktop:make": "npm run build && electron-forge make --platform=win32 --arch=x64",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:core": "node --import tsx tests/core-stock.test.ts && node --import tsx tests/farm-setup.test.ts && node --import tsx tests/backup.test.ts && node --import tsx tests/sqlite-store.test.ts && node --import tsx tests/office-accounting.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-squirrel": "^7.8.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "electron": "^43.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
